{
  "name": "blogs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "textlint": "textlint \"**/*.md\"",
    "textlint:fix": "textlint --fix \"**/*.md\"",
    "textlint:files": "textlint",
    "markdownlint": "markdownlint-cli2 \"**/*.md\"",
    "markdownlint:fix": "markdownlint-cli2 --fix \"**/*.md\"",
    "markdownlint:files": "markdownlint-cli2",
    "commitlint": "commitlint"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@textlint-ja/textlint-rule-preset-ai-writing": "^1.7.0",
    "lefthook": "^2.1.10",
    "markdownlint-cli2": "^0.24.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.74.0",
    "textlint": "^15.7.1",
    "textlint-rule-preset-ja-technical-writing": "^12.0.2"
  },
  "engines": {
    "npm": ">=11.20.0"
  },
  "allowScripts": {
    "lefthook": true
  }
}
