{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Edit",
      "Write",
      "WebFetch",
      "WebSearch",
      "Skill(retrospective)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git mv*)",
      "Bash(git rm*)",
      "Bash(npm run fmt*)",
      "Bash(npm run lint*)",
      "Bash(npm run textlint*)",
      "Bash(npm run markdownlint*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && npm run fmt:check >&2 || exit 2",
            "timeout": 30,
            "statusMessage": "oxfmt で編集内容を確認しています"
          },
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && npm run lint >&2 || exit 2",
            "timeout": 30,
            "statusMessage": "oxlint で編集内容を確認しています"
          },
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && npm run textlint >&2 || exit 2",
            "timeout": 30,
            "statusMessage": "textlint で編集内容を確認しています"
          },
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && npm run markdownlint >&2 || exit 2",
            "timeout": 30,
            "statusMessage": "markdownlint で編集内容を確認しています"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/retrospective-session-start.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/retrospective-trigger.sh"
          }
        ]
      }
    ]
  }
}
