{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Edit",
      "Write",
      "NotebookEdit",
      "WebFetch",
      "WebSearch",
      "Skill(update-config)",
      "Skill(retrospective)",
      "Bash(git *)",
      "Bash(pnpm run *)",
      "Bash(pnpm exec *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && pnpm fmt:check >&2 || exit 2",
            "timeout": 30,
            "statusMessage": "oxfmt で編集内容を確認しています"
          },
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && pnpm lint >&2 || exit 2",
            "timeout": 30,
            "statusMessage": "oxlint で編集内容を確認しています"
          },
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && pnpm textlint >&2 || exit 2",
            "timeout": 30,
            "statusMessage": "textlint で編集内容を確認しています"
          },
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && pnpm markdownlint >&2 || exit 2",
            "timeout": 30,
            "statusMessage": "markdownlint で編集内容を確認しています"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/retrospective-session-start.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/retrospective-trigger.sh"
          }
        ]
      }
    ]
  }
}
